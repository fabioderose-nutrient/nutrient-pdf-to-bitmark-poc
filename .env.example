# Nutrient license keys. Leave empty to run the SDKs in evaluation mode.
NUTRIENT_LICENSE_KEY=
NUTRIENT_WEB_LICENSE_KEY=

# Optional learning checks: openai, anthropic or ollama. Auto-detected from the keys when empty.
AI_PROVIDER=
AI_MODEL=
AI_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Conversion settings
BOOK_LANGUAGE=en
LAYOUT_CONFIDENCE=0.2
OUTPUT_DIR=
PORT=8082
